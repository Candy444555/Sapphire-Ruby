{
  "expo": {
    "name": "Lexi",
    "slug": "my-new-project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lexi-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lexi.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Lexi uses the camera so you can send photos and live shots into your conversation.",
        "NSPhotoLibraryUsageDescription": "Lexi needs photo library access to attach images to your messages.",
        "NSMicrophoneUsageDescription": "Lexi uses the microphone for voice messages.",
        "NSLocationWhenInUseUsageDescription": "Lexi can use your location to give context-aware answers.",
        "NSContactsUsageDescription": "Lexi can read your contacts to help you message, call, or look someone up.",
        "NSCalendarsUsageDescription": "Lexi can read your calendar to help you plan and manage events.",
        "NSRemindersUsageDescription": "Lexi can read and create reminders for you.",
        "NSMotionUsageDescription": "Lexi uses motion data for activity-aware features.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock Lexi.",
        "NSBluetoothAlwaysUsageDescription": "Lexi uses Bluetooth to interact with nearby devices.",
        "NSLocalNetworkUsageDescription": "Lexi uses the local network to discover devices.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.lexi.mobile",
      "versionCode": 8,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MANAGE_EXTERNAL_STORAGE",
        "DOWNLOAD_WITHOUT_NOTIFICATION",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/with-gradle-properties",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      "expo-location",
      "expo-contacts",
      "expo-calendar",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "rubywilliam444",
    "extra": {
      "eas": {
        "projectId": "7ccd35ca-bf3d-460e-a3a1-b4ad337478a6"
      },
      "apiDomain": "lexi-22--williamruby000.replit.app"
    }
  }
}
